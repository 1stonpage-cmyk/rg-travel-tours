# ---------------------------------------------------------------------------
# TravelSugbo (operated by R&G Travel & Tours) - environment template. Copy to .env and fill in.
# PORTS: Kong PMS also runs on this machine. NEVER use 5173 or 3000.
# ---------------------------------------------------------------------------

# NODE_ENV is deliberately NOT set here. Vite derives it from the build mode
# (`vite` -> development, `vite build` -> production); envDir in
# client/vite.config.ts makes Vite read this file for VITE_* vars, and a
# NODE_ENV line here would override Vite's own mode detection and force every
# `vite build` into a development build (dev JSX runtime, no prod
# optimizations, ~59% larger bundle). The server doesn't need it from here
# either: server/src/env.ts's Zod schema defaults NODE_ENV to 'development'
# for local use. In production, NODE_ENV=production is set by the process
# manager (PM2), not by a committed file.

# Server (Express + tRPC)
PORT=3100

# Client (Vite dev server) - strictPort is enabled, so this must be free
CLIENT_PORT=5180

# Public base URL of the site
PUBLIC_BASE_URL=http://localhost:5180

# development | preview | production. Controls robots.txt and X-Robots-Tag (task 5D).
SITE_ENV=development

# ---------------------------------------------------------------------------
# Database - MySQL 8. Database name MUST be rg_travel (separate from Kong's DB).
# Schema and migrations land in task 1B; nothing connects yet.
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://rg_travel:CHANGE_ME@localhost:3306/rg_travel
DB_USER=rg_travel
DB_PASSWORD=CHANGE_ME
DB_NAME=rg_travel

# ---------------------------------------------------------------------------
# Test database (task 1.4b) - dedicated to `pnpm test`, never rg_travel.
# Same rg_travel user, database name rg_travel_test. Tests truncate freely,
# so this must stay a separate, disposable database from the one above.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=mysql://rg_travel:CHANGE_ME@localhost:3306/rg_travel_test

# ---------------------------------------------------------------------------
# Sessions (task 1C - unused for now)
# ---------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME_32_CHARS_MINIMUM

# ---------------------------------------------------------------------------
# PayMongo. NEVER expose these to the client, never commit a real value.
#
# Both are OPTIONAL: the server boots fine without them. The consequences of
# leaving them blank are deliberate and fail closed -
#   PAYMONGO_SECRET_KEY    missing -> createCheckout() throws at the first
#                          payment attempt (PaymongoNotConfiguredError)
#   PAYMONGO_WEBHOOK_SECRET missing -> every webhook signature check answers
#                          false, so POST /api/webhooks/paymongo is a 400 and
#                          nothing can be marked paid
# Use the sk_test_ / test webhook secret pair locally. The provider talks to
# PayMongo over plain fetch - there is no SDK, by design (Global Constraints).
# ---------------------------------------------------------------------------
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email / SMTP (task 7E - unused for now)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TravelSugbo <noreply@travelsugbo.com>"

# ---------------------------------------------------------------------------
# SMS - off by default (task 7E)
# ---------------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=

# ---------------------------------------------------------------------------
# Uploads - resolved OUTSIDE the web root
# ---------------------------------------------------------------------------
UPLOADS_DIR=./uploads

# The ONLY origin allowed to make state-changing requests (CSRF, section 12).
# Production MUST be the real site: https://travelsugbo.com
# Outside production, http://localhost:5180 is allowed as well.
APP_ORIGIN=http://localhost:5180

# The first owner account, read by `pnpm --filter @rg/server db:seed`.
# Leave BOTH blank here. Set them in the deployed .env only, use a strong
# unique password of at least 12 characters, and REMOVE OWNER_PASSWORD from
# the server .env once the first seed has run.
OWNER_EMAIL=
OWNER_PASSWORD=

# ---------------------------------------------------------------------------
# Public contact details
#
# The phone numbers, WhatsApp/Viber targets and Facebook URL are real and now
# live as constants in client/src/lib/site.ts, because the standalone
# coming-soon page is static HTML that cannot read Vite env - the two surfaces
# must stay byte-identical (scripts/check-contact-parity.mjs enforces it).
# Only the email address is still env-overridable.
# ---------------------------------------------------------------------------
VITE_CONTACT_EMAIL=hello@travelsugbo.com

# ---------------------------------------------------------------------------
# Cookie consent (task 2D, 05-cookie-consent-spec.md) — owner decision
# 2026-10-27, #1 and #3. GA4 and Meta Pixel are both opt-in only, gated by
# the cookie consent banner. Leave BOTH blank here: an empty id means that
# tool never loads, even with consent — this is also what keeps local dev
# and `pnpm test` from ever pinging a real account. NEVER commit a real id.
# ---------------------------------------------------------------------------
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
